# Haebaragi Studio — Environment Variables
# Copy this file to .env.local and fill in your values.

# Formspree endpoint for the contact form.
# Sign up at https://formspree.io, create a form, and paste your endpoint URL here.
# Example: https://formspree.io/f/abcd1234
VITE_FORMSPREE_ENDPOINT=https://formspree.io/f/your-form-id
